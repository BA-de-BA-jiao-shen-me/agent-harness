# === LLM Provider & Multi-Model Failover Router ===
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Optional fallback & fast tier models
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FAST_MODEL=

# === Enterprise Security Control Plane (AuthN / RBAC / ACP / FinOps) ===
HARNESS_PROFILE=enterprise
# Use `dev_anonymous` for zero-config local exploration; set `enforce` in production
HARNESS_AUTH_MODE=dev_anonymous
HARNESS_JWT_SECRET=change-me-to-a-32-byte-random-secret
HARNESS_API_KEYS_JSON=
HARNESS_TRUST_PROXY_HEADERS=false
HARNESS_APPROVAL_ALLOW_SELF=false
HARNESS_CORS_ORIGINS=http://localhost:3000
HARNESS_POLICY_FILE=./policies/enterprise_policy.yaml
HARNESS_RPM_LIMIT=60
HARNESS_QUOTA_ENABLED=true

# === Runtime Governance Defaults ===
HARNESS_MAX_STEPS=10
HARNESS_MAX_PARALLEL_TOOLS=4
HARNESS_CONTEXT_COMPRESS_THRESHOLD=6000
HARNESS_MAX_TOKENS_PER_TURN=32000
HARNESS_JOURNAL_DB=./data/event_journal.sqlite3
# Optional: set postgresql://... for horizontally scaled multi-Pod EventJournal
DATABASE_URL=

# === Pluggable Sandbox Seam (auto | docker | e2b | subprocess) ===
HARNESS_SANDBOX_PROVIDER=auto
DOCKER_HOST=
DOCKER_SANDBOX_IMAGE=python:3.11-slim
# Optional: set to `runsc` to enforce gVisor user-space kernel isolation on Docker hosts
DOCKER_SANDBOX_RUNTIME=
E2B_API_KEY=
E2B_API_URL=https://api.e2b.dev

# === Distributed Infrastructure (leave empty for local in-memory mode) ===
REDIS_URL=
QDRANT_URL=
QDRANT_COLLECTION=pyharness_chunks
